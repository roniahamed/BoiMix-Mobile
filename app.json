{
  "expo": {
    "name": "BoiMix",
    "slug": "boimix-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "boimix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E84C1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.boimix.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "কাছের বই খুঁজতে আপনার লোকেশন প্রয়োজন।",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "কাছের বই খুঁজতে আপনার লোকেশন প্রয়োজন।",
        "NSCameraUsageDescription": "ISBN স্ক্যান ও বইয়ের ছবি তুলতে ক্যামেরা প্রয়োজন।",
        "NSPhotoLibraryUsageDescription": "বইয়ের ছবি আপলোড করতে ফটো লাইব্রেরি প্রয়োজন।"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#E84C1E"
      },
      "package": "com.boimix.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
